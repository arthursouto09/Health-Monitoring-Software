# Copy to .env.local for local development (never commit .env.local).
# In production, set these in Vercel: Project > Settings > Environment Variables.

# Postgres connection string (e.g. Neon, created from Vercel > Storage).
# Leave empty locally to store data in .data/db.json instead.
DATABASE_URL=

# Long random string used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Demo account (astronaut / mars2026) created on an empty database. Set to "off" to disable.
DEMO_ACCOUNT=on
